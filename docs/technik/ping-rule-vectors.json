{
  "version": 1,
  "description": "Test vectors of the notification ping rule. Each vector: inbox entry + device settings + local time -> expected result. Missing 'settings' = everything on, no quiet hours.",
  "categories": ["blocked", "mentions", "approvals", "failed_runs", "assignments"],
  "channels": ["operator_blocked", "operator_mentions", "operator_approvals", "operator_assignments", "operator_quiet"],
  "vectors": [
    { "id": "mentioned", "item": { "type": "mentioned", "severity": "info", "details": null, "read": false, "archived": false }, "expect": { "ping": true, "category": "mentions", "channel": "operator_mentions" } },
    { "id": "status-blocked", "item": { "type": "status_changed", "severity": "info", "details": { "from": "in_progress", "to": "blocked" }, "read": false, "archived": false }, "expect": { "ping": true, "category": "blocked", "channel": "operator_blocked" } },
    { "id": "status-in-review", "item": { "type": "status_changed", "severity": "info", "details": { "from": "in_progress", "to": "in_review" }, "read": false, "archived": false }, "expect": { "ping": true, "category": "approvals", "channel": "operator_approvals" } },
    { "id": "status-testing-no-ping", "item": { "type": "status_changed", "severity": "info", "details": { "from": "in_progress", "to": "testing" }, "read": false, "archived": false }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "status-done-no-ping", "item": { "type": "status_changed", "severity": "info", "details": { "from": "in_review", "to": "done" }, "read": false, "archived": false }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "status-from-blocked-no-ping", "item": { "type": "status_changed", "severity": "info", "details": { "from": "blocked", "to": "in_progress" }, "read": false, "archived": false }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "status-without-details", "item": { "type": "status_changed", "severity": "info", "details": null, "read": false, "archived": false }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "task-failed", "item": { "type": "task_failed", "severity": "action_required", "details": null, "read": false, "archived": false }, "expect": { "ping": true, "category": "failed_runs", "channel": "operator_blocked" } },
    { "id": "issue-assigned", "item": { "type": "issue_assigned", "severity": "action_required", "details": null, "read": false, "archived": false }, "expect": { "ping": true, "category": "assignments", "channel": "operator_assignments" } },
    { "id": "agent-blocked-future", "item": { "type": "agent_blocked", "severity": "info", "details": null, "read": false, "archived": false }, "expect": { "ping": true, "category": "blocked", "channel": "operator_blocked" } },
    { "id": "review-requested-future", "item": { "type": "review_requested", "severity": "info", "details": null, "read": false, "archived": false }, "expect": { "ping": true, "category": "approvals", "channel": "operator_approvals" } },
    { "id": "new-comment-no-ping", "item": { "type": "new_comment", "severity": "info", "details": null, "read": false, "archived": false }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "action-required-other-type-no-ping", "item": { "type": "quick_create_failed", "severity": "action_required", "details": null, "read": false, "archived": false }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "unknown-type-no-ping", "item": { "type": "something_new", "severity": "action_required", "details": { "to": "blocked" }, "read": false, "archived": false }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "read-no-ping", "item": { "type": "mentioned", "severity": "info", "details": null, "read": true, "archived": false }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "archived-no-ping", "item": { "type": "status_changed", "severity": "info", "details": { "from": "todo", "to": "blocked" }, "read": false, "archived": true }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "master-off", "item": { "type": "mentioned", "severity": "info", "details": null, "read": false, "archived": false }, "settings": { "enabled": false }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "category-off", "item": { "type": "status_changed", "severity": "info", "details": { "from": "todo", "to": "in_review" }, "read": false, "archived": false }, "settings": { "disabledCategories": ["approvals"] }, "expect": { "ping": false, "category": null, "channel": null } },
    { "id": "other-category-off-still-pings", "item": { "type": "mentioned", "severity": "info", "details": null, "read": false, "archived": false }, "settings": { "disabledCategories": ["approvals", "assignments"] }, "expect": { "ping": true, "category": "mentions", "channel": "operator_mentions" } },
    { "id": "quiet-hours-overnight-inside", "item": { "type": "status_changed", "severity": "info", "details": { "from": "todo", "to": "blocked" }, "read": false, "archived": false }, "settings": { "quietHours": { "start": "22:00", "end": "07:00" } }, "localTime": "23:30", "expect": { "ping": true, "category": "blocked", "channel": "operator_quiet" } },
    { "id": "quiet-hours-overnight-early-morning", "item": { "type": "mentioned", "severity": "info", "details": null, "read": false, "archived": false }, "settings": { "quietHours": { "start": "22:00", "end": "07:00" } }, "localTime": "06:59", "expect": { "ping": true, "category": "mentions", "channel": "operator_quiet" } },
    { "id": "quiet-hours-end-exclusive", "item": { "type": "mentioned", "severity": "info", "details": null, "read": false, "archived": false }, "settings": { "quietHours": { "start": "22:00", "end": "07:00" } }, "localTime": "07:00", "expect": { "ping": true, "category": "mentions", "channel": "operator_mentions" } },
    { "id": "quiet-hours-start-inclusive", "item": { "type": "task_failed", "severity": "action_required", "details": null, "read": false, "archived": false }, "settings": { "quietHours": { "start": "22:00", "end": "07:00" } }, "localTime": "22:00", "expect": { "ping": true, "category": "failed_runs", "channel": "operator_quiet" } },
    { "id": "quiet-hours-same-day-outside", "item": { "type": "issue_assigned", "severity": "action_required", "details": null, "read": false, "archived": false }, "settings": { "quietHours": { "start": "12:00", "end": "13:00" } }, "localTime": "11:59", "expect": { "ping": true, "category": "assignments", "channel": "operator_assignments" } },
    { "id": "quiet-hours-category-off-wins", "item": { "type": "mentioned", "severity": "info", "details": null, "read": false, "archived": false }, "settings": { "disabledCategories": ["mentions"], "quietHours": { "start": "22:00", "end": "07:00" } }, "localTime": "23:00", "expect": { "ping": false, "category": null, "channel": null } }
  ]
}
