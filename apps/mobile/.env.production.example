# Copy this file to .env.production.local and edit it before running a
# production-variant build. The .local file is gitignored.
#
# Upstream default backend; the app lets the user enter their own server, so
# these are only build-time defaults.
EXPO_PUBLIC_API_URL=https://api.multica.ai
EXPO_PUBLIC_WEB_URL=https://multica.ai

# Optional, iOS only (upstream; not used by the Android build): use your own
# reverse-domain if your Apple ID cannot sign the default production bundle ID.
# EXPO_BUNDLE_IDENTIFIER_PROD=com.yourname.multica
